# --- Acceso -----------------------------------------------------------------
# Sin código, la aplicación está abierta a quien llegue a la URL — y cada vídeo
# gasta créditos de renderizado. Ponlo antes de publicarla.
APP_ACCESS_CODE=
# Clave con la que se firma la cookie de sesión. Si la dejas vacía se usa el
# propio código de acceso; cámbiala para invalidar todas las sesiones abiertas.
APP_SESSION_SECRET=

# URL pública de la aplicación. La usan la tarjeta de enlace (OG) y el montaje,
# que descarga el logotipo por HTTP y no tiene ninguna URL relativa que seguir.
APP_URL=

# Permite que la aplicación lance procesos en el servidor: el plugin de línea
# de comandos y el transporte local de MCP. Es ejecución de código arbitrario
# para quien pase el código de acceso, así que está desactivado por defecto.
ENGINE_ALLOW_COMMANDS=

# --- Clasificación de fotos -------------------------------------------------
# Quién decide qué muestra cada foto. Sin valor: por nombre de fichero, que no
# necesita nada instalado. "ollama" usa un modelo local que mira la imagen,
# clasifica todas las estancias y avisa de planos de planta o fotos inservibles.
# Se puede cambiar también desde Ajustes.
VISION_DRIVER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tiene que ser un modelo con visión de verdad. Declararla no basta: hemos visto
# uno que la anunciaba y respondía lo mismo a una imagen roja y a una azul.
# Verificado: qwen2.5vl:7b
OLLAMA_VISION_MODEL=

# --- Motor de vídeo ---------------------------------------------------------
# La clave también se puede conectar desde Ajustes, en la propia aplicación.
# Si la pones aquí, manda sobre lo que se escriba en el panel y este la muestra
# como bloqueada.
#
# Provider selection.
# Leave everything unset and the app uses the simulated provider, so it runs
# with no configuration at all. Set HIGGSFIELD_API_KEY to switch to real
# renders, or force a choice with VIDEO_PROVIDER=mock|higgsfield.
VIDEO_PROVIDER=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai/v1

# Dónde se guardan las fotos y dónde viven los lotes. Los valores por defecto
# (disco local y memoria) solo valen para desarrollo o un servidor con disco
# persistente — ver el aviso de producción en el README.
STORAGE_DRIVER=local
BATCH_STORE=memory

# Montaje del vídeo final descargable. Sin valor: usa ffmpeg si está
# disponible, y si no se queda en la lista de reproducción del cliente.
# "none" lo desactiva del todo.
STITCH_DRIVER=
# Ruta al binario, si no está en el PATH.
FFMPEG_PATH=
STITCH_TIMEOUT_MINUTES=10

# Fraction (0-1) of simulated jobs that fail, for exercising the retry and
# partial-reel paths. Only used by the simulated provider.
MOCK_FAILURE_RATE=0

# Pipeline tuning — see src/lib/config.ts for defaults and accepted ranges.
# Each photo becomes one provider job, so these bound cost and rate limiting.
MAX_PHOTOS_PER_BATCH=20
CREATE_CONCURRENCY=4
POLL_CONCURRENCY=6
MAX_CLIP_ATTEMPTS=2
DEFAULT_CLIP_SECONDS=5
BATCH_TTL_MINUTES=60

# Espera antes de reintentar un clip fallido, que se dobla en cada intento.
# Reintentar al instante vuelve a chocar con el mismo rate limit.
RETRY_BACKOFF_SECONDS=15

# A partir de aquí se da por perdido un clip que el proveedor no termina, en
# vez de sondearlo indefinidamente.
CLIP_TIMEOUT_MINUTES=10
